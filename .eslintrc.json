{
  "extends": [
    "next/core-web-vitals",
    "prettier"
  ],
  "parserOptions": {
    "project": "./tsconfig.json"
  },
  "rules": {
    "quotes": ["error", "double"],
    "semi": 1,
    "import/prefer-default-export": "off",
    "react/react-in-jsx-scope": "off",
    "eslint-disable no-param-reassign": "off",
    "no-param-reassign": "off",
    "no-console": "off"
  }
}
